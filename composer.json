{
    "name": "firesphere/graphql-jwt",
    "description": "JWT Authentication for GraphQL",
    "type": "silverstripe-vendormodule",
    "license": "bsd-3-clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/graphql": "^6.0",
        "lcobucci/jwt": "^4.0.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "extra": {
        "branch-alias": {
            "dev-silverstripe-6": "4.0.x-dev"
        },
        "installer-name": "graphql-jwt"
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Firesphere\\GraphQLJWT\\": "src/",
            "Firesphere\\GraphQLJWT\\Tests\\": "tests/unit/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
